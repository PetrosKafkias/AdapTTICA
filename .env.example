# Set to "true" to use the real Express + SQLite backend under server/
# (started with `npm run dev:server` or together with `npm run dev`),
# reached through the Vite dev-server proxy on the same origin so the
# session cookie survives. Leave unset/false to fall back to the portable,
# browser-only localStorage adapter in src/local-api.js with no backend
# required at all.
VITE_USE_REMOTE_API=true

# Advanced/legacy option: point at an API served from a different origin.
# The vendored frontend bundle hardcodes `credentials: "same-origin"` on
# every request, so this only works if that origin is reached through a
# same-origin reverse proxy in front of both the frontend and the API -
# a bare cross-origin URL here cannot carry the session cookie.
VITE_API_BASE_URL=

# Optional development ports.
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# Backend server (server/src/index.js).
API_PORT=8787
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: override the SQLite file location and upload directory.
# DATABASE_FILE=server/data/adapttica.sqlite
# UPLOAD_DIR=server/uploads

# First-run seed account (npm run db:seed). Change the password after first login.
SEED_ADMIN_EMAIL=admin@adapttica.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Local role-card demo accounts use this password. Override it before sharing
# a non-local environment, or omit the demo seed entirely in deployment.
SEED_DEMO_PASSWORD=Demo123!

# UserWay accessibility widget. Leave the account id empty to use the local,
# keyboard-accessible fallback controls during development.
VITE_USERWAY_ACCOUNT_ID=
VITE_USERWAY_SCRIPT_URL=https://cdn.userway.org/widget.js

# Outgoing email (server/src/lib/mailer.js). Leave SMTP_HOST empty to skip
# sending and just log — every value below is a placeholder; real sending
# requires real credentials from your provider (SMTP relay, Resend,
# SendGrid, Postmark, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=notifications@adapttica.local
# Receives "new material submitted for review" emails for the Knowledge
# Library moderation workflow.
MODERATION_EMAIL=dreven-moderation@example.org
# Used to build absolute links in emails (e.g. https://adapttica.example.org).
APP_BASE_URL=http://localhost:5173

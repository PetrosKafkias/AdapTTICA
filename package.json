{
  "name": "adapttica-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/src/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "cross-env NODE_ENV=production node server/src/index.js",
    "db:migrate": "node server/src/migrate.js",
    "db:seed": "node server/src/seed.js",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run --testTimeout=15000",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "optionalDependencies": {
    "@libsql/linux-x64-gnu": "^0.5.29"
  }
}

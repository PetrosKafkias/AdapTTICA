{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/migrations/sqlite/**,node_modules/@libsql/linux-x64-gnu/**,node_modules/@libsql/linux-x64-musl/**}"
    }
  }
}
